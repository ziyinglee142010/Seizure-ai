  <diagram id="page-1" name="MDS01 system overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="browser" value="&lt;b&gt;Owner's browser&lt;/b&gt;&lt;br&gt;Next.js frontend (:3000)&lt;br&gt;EEG-only · video-only · combined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI backend&lt;/b&gt; (:8000)&lt;br&gt;sign-in · owner-only routes&lt;br&gt;private, no-store responses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="395" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eeg" value="&lt;b&gt;EEG processing&lt;/b&gt; (BackgroundTasks)&lt;br&gt;validate → de-identify → preprocess&lt;br&gt;→ SeizureTransformer → explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vsvig" value="&lt;b&gt;VSViG worker&lt;/b&gt; (one at a time)&lt;br&gt;5-s pose gate → OpenPose&lt;br&gt;→ 15 RGB patches → VSViG scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="emotion" value="&lt;b&gt;Emotion worker&lt;/b&gt; (own lane)&lt;br&gt;runs alongside VSViG, every clip&lt;br&gt;face → expression per second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="veeg" value="&lt;b&gt;VEEG reference workers&lt;/b&gt;&lt;br&gt;clock/format probe · EEG sync&lt;br&gt;H.264 copy only when opened" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="690" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="enc-files" value="&lt;b&gt;Encrypted files&lt;/b&gt; (AES-GCM)&lt;br&gt;backend/storage/sessions/{id}/&lt;br&gt;original/ · retained/&lt;br&gt;EEG archives, source report, original video,&lt;br&gt;review video, playback copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="80" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tmp-files" value="&lt;b&gt;Temporary plaintext&lt;/b&gt;&lt;br&gt;work/ · emotion-work/&lt;br&gt;decrypted copies, frames, patches&lt;br&gt;&lt;i&gt;deleted after each step and on restart&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="330" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color='#2d7a2d'&gt;Encrypted rows:&lt;/font&gt; VSViG results, emotion results,&lt;br&gt;patient name/ID, sync anchors, clinical notes&lt;br&gt;&lt;font color='#555555'&gt;Plain rows:&lt;/font&gt; users, cases, job status,&lt;br&gt;de-identified EEG scores + explanations" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
