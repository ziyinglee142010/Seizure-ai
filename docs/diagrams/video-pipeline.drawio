<mxfile host="app.diagrams.net" agent="Codex drawio-mxgraph skill" version="24.7.17" type="device" compressed="false">
  <diagram id="page-1" name="MDS01 video pipeline and encryption">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="upload" value="&lt;b&gt;Owner's browser&lt;/b&gt;&lt;br&gt;selects a video&lt;br&gt;(analysis or VEEG reference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="505" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;stream the upload and&lt;br&gt;AES-GCM encrypt it,&lt;br&gt;then acknowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="495" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="original" value="&lt;b&gt;Encrypted original&lt;/b&gt;&lt;br&gt;original/video.input.enc&lt;br&gt;never stored as plaintext&lt;br&gt;kept until case deletion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="490" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a-probe" value="&lt;b&gt;Metadata worker&lt;/b&gt;&lt;br&gt;decrypt a temporary copy → read clock&lt;br&gt;+ format → match EEG (unique match only)&lt;br&gt;&lt;i&gt;temporary copy deleted&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-anchors" value="&lt;b&gt;Sync anchors + offsets&lt;/b&gt;&lt;br&gt;encrypted in PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="105" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-open" value="owner opens&lt;br&gt;playback: browser-&lt;br&gt;compatible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="205" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a-stream" value="&lt;b&gt;Yes:&lt;/b&gt; decrypt only the requested byte&lt;br&gt;ranges (chunk AES-GCM) → private stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="200" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a-copy" value="&lt;b&gt;No:&lt;/b&gt; make an audio-free H.264 copy once&lt;br&gt;→ &lt;b&gt;encrypted playback copy&lt;/b&gt;, then stream it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="275" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b-admit" value="&lt;b&gt;Admission check&lt;/b&gt;&lt;br&gt;decrypt a temporary copy → metadata&lt;br&gt;+ opening 5-second pose check&lt;br&gt;&lt;i&gt;temporary copy deleted&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="410" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="b-gate" value="passes?&lt;br&gt;1920×1080 and&lt;br&gt;15 landmarks" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="400" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b-vsvig" value="&lt;b&gt;VSViG worker&lt;/b&gt;&lt;br&gt;decrypt to work/ → normalised frames&lt;br&gt;→ OpenPose + 15 unblurred RGB patches&lt;br&gt;→ VSViG window scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="400" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-work" value="&lt;b&gt;work/&lt;/b&gt; temporary plaintext:&lt;br&gt;decrypted video, frames, patches&lt;br&gt;&lt;i&gt;deleted after the job&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="560" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-scores" value="&lt;b&gt;VSViG scores&lt;/b&gt; + Grad-CAM&lt;br&gt;encrypted in PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="400" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b-review" value="&lt;b&gt;Review video&lt;/b&gt;&lt;br&gt;audio-free H.264&lt;br&gt;encrypted file (retained/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="480" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-reject" value="&lt;b&gt;No: review copy only&lt;/b&gt;&lt;br&gt;audio-free H.264 → encrypted&lt;br&gt;job ends with the reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="580" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-emotion" value="&lt;b&gt;Emotion worker&lt;/b&gt;&lt;br&gt;decrypt to emotion-work/ → find the face&lt;br&gt;→ expression each second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="770" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-work" value="&lt;b&gt;emotion-work/&lt;/b&gt; temporary plaintext&lt;br&gt;no face images written&lt;br&gt;&lt;i&gt;deleted after each run&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="775" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-scores" value="&lt;b&gt;Emotion scores&lt;/b&gt; per second&lt;br&gt;encrypted in PostgreSQL (own field)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1490" y="780" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="view" value="&lt;b&gt;Viewing results&lt;/b&gt; — every video, score and emotion request checks the owner, decrypts on demand, and returns a private, no-store response. Raw names, file paths and keys are never returned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="950" width="1180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#2d7a2d'&gt;■ green&lt;/font&gt; encrypted at rest&lt;br&gt;&lt;font color='#b36b00'&gt;■ orange dashed&lt;/font&gt; temporary plaintext,&lt;br&gt;   deleted after use&lt;br&gt;&lt;font color='#b36b00'&gt;⇢ orange arrow&lt;/font&gt; decrypt a temporary copy&lt;br&gt;&lt;font color='#6c8ebf'&gt;■ blue&lt;/font&gt; processing step&lt;br&gt;&lt;font color='#b8962e'&gt;◆ yellow&lt;/font&gt; decision&lt;br&gt;&lt;br&gt;Keys: MDS01_STORAGE_KEY in .env,&lt;br&gt;outside Git and backups.&lt;br&gt;Restart: leftover plaintext is&lt;br&gt;deleted and emotion runs resume." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="260" height="250" as="geometry" />
        </mxCell>
